# Ignore everything in the .codex directory by default.
*

# Keep only durable instruction and skill surfaces in this repo.
!.gitignore

# Active home-level instructions.
!AGENTS.md
!SOUL.md
!docs/
!docs/**

# Local role docs.
!roles/
!roles/**/
!roles/**/SKILL.md

# Optional design prompt bundle.
!design-system-prompt/
!design-system-prompt/**

# Local user/community skills. System-bundled skills stay generated.
!skills/
!skills/**
!skills/.skill-lock.json
skills/.system/
skills/.system/**

# Explicitly ignore the rules folder as requested.
/rules/
