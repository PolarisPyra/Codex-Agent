# Ignore everything in the .codex directory by default.
*

# Keep only durable instruction surfaces in this repo.
!.gitignore

# Active home-level instructions.
!AGENTS.md
!SOUL.md
!docs/
!docs/**

# Local role docs.
!roles/
!roles/**/
!roles/**/SKILL.md

# Skills are runtime-managed here. Local user/community skills live in
# /home/polaris/.agents/skills and system-bundled skills stay generated.
/skills/

# Explicitly ignore the rules folder as requested.
/rules/

# Local scratch notes and explicit memory-update notes are not published.
/notes/
/memories/extensions/ad_hoc/notes/
